+// A full-width glyph reserves its next cell. Do not turn that continuation
+// cell into an extra space when checking visible Chinese text.
+fn buffer_display_text(buffer: &Buffer) -> String {
+    buffer
+        .content
+        .chunks(usize::from(buffer.area.width))
+        .map(|row| {
+            let mut text = String::new();
+            let mut column = 0;
+            while column < row.len() {
+                let symbol = row[column].symbol();
+                text.push_str(symbol);
+                column += unicode_width::UnicodeWidthStr::width(symbol).max(1);
+            }
+            text.trim_end().to_string()
+        })
+        .collect::<Vec<_>>()
+        .join("\n")
+}
