 //! Keep the production shortcut picker's controls anchored while groups and results change.
 
 use super::*;
+
+#[test]
+fn same_action_id_keeps_context_specific_labels_and_dispatch() {
+    assert_eq!(action_label("editor", "move_up"), "光标上移");
+    assert_eq!(action_label("list", "move_up"), "列表选择上移");
+    assert_eq!(action_label("vim_text_object", "cancel"), "取消待选择的文本对象");
+    assert_eq!(action_label("list", "cancel"), "取消并关闭选择界面");
+    let runtime = RuntimeKeymap::defaults();
+    let params = build_keymap_picker_params(&runtime, &TuiKeymap::default());
+    let (tx, mut rx) = unbounded_channel();
+    let mut view = ListSelectionView::new(params, AppEventSender::new(tx), runtime.list);
+    view.set_search_query("list.move_up".to_string());
+    view.handle_key_event(KeyEvent::from(KeyCode::Enter));
+    assert!(matches!(rx.try_recv(), Ok(AppEvent::OpenKeymapActionMenu { context, action })
+        if context == "list" && action == "move_up"));
+}
+
+#[test]
+fn chinese_english_and_config_id_search_open_the_same_action() {
+    for query in ["打开对话记录", "Open Transcript", "global.open_transcript"] {
+        let runtime = RuntimeKeymap::defaults();
+        let params = build_keymap_picker_params(&runtime, &TuiKeymap::default());
+        let (tx, mut rx) = unbounded_channel();
+        let mut view = ListSelectionView::new(params, AppEventSender::new(tx), runtime.list);
+        view.set_search_query(query.to_string());
+        view.handle_key_event(KeyEvent::from(KeyCode::Enter));
+        assert!(matches!(rx.try_recv(), Ok(AppEvent::OpenKeymapActionMenu { context, action })
+            if context == "global" && action == "open_transcript"), "query: {query}");
+    }
+}
