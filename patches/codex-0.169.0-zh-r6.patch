+        (
+            "prevent_idle_sleep",
+            "Prevent sleep while running",
+            "运行时防止休眠",
+        ),
+    ];
+    let (app_tx, mut app_rx) = tokio::sync::mpsc::unbounded_channel();
+    let mut view = ExperimentalFeaturesView::new(
+        entries
+            .iter()
+            .map(|(key, name, _)| ExperimentalFeatureItem {
+                key: (*key).into(),
+                name: (*name).into(),
+                description: "Keep your computer awake while Codex is running a thread.".into(),
+                enabled: false,
+                writable: true,
+            })
+            .collect(),
+        ThreadId::new(),
+        None,
+        AppEventSender::new(app_tx),
+        crate::keymap::RuntimeKeymap::defaults().list,
+    );
+    let rows = view.build_rows();
+    for (index, (key, name, chinese)) in entries.iter().enumerate() {
+        assert!(rows[index].name.contains(chinese));
+        assert_eq!(
+            rows[index].description.as_deref(),
+            Some("Codex 运行聊天任务期间，让电脑保持唤醒。")
+        );
+        assert_eq!(view.features[index].key, *key);
+        assert_eq!(view.features[index].name, *name);
+        assert!(!view.features[index].enabled);
+    }
+    for width in [80, 120] {
+        let area = Rect::new(0, 0, width, view.desired_height(width));
+        let mut buffer = Buffer::empty(area);
+        view.render(area, &mut buffer);
+        let text = buffer_display_text(&buffer);
+        for (_, _, chinese) in entries {
+            assert!(text.contains(chinese), "width={width}: {text}");
+        }
+        assert!(text.contains("保存并关闭"));
+        assert!(!text.contains("Checked features"));
+    }
+    // Translation must not change the stable key or invoke a real config write.
+    view.state.selected_idx = Some(2);
+    view.toggle_selected();
+    assert!(view.features[2].enabled);
+    assert_eq!(view.features[2].key, "network_proxy");
+    assert!(
+        view.features
+            .iter()
+            .enumerate()
+            .all(|(i, item)| item.enabled == (i == 2))
+    );
+    assert!(app_rx.try_recv().is_err());
