+fn localized_token_summary(usage: &crate::token_usage::TokenUsage, provisional: bool) -> String {
+    let original = usage.to_string();
+    let Some(details) = original.strip_prefix("Token usage:") else {
+        return original;
+    };
+    let prefix = if provisional {
+        "目前的 token 用量："
+    } else {
+        "token 用量："
+    };
+    let details = details
+        .replace("total=", "非缓存合计=")
+        .replace("input=", "输入=")
+        .replace("output=", "输出=")
+        .replace(" cached)", " 缓存)")
+        .replace("(reasoning ", "(推理 ");
+    format!("{prefix}{details}")
+}
