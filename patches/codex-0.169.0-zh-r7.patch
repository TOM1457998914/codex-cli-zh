+//! Localize help metadata at the presentation boundary; argument IDs and values stay intact.
+use std::collections::BTreeMap;
+use std::sync::LazyLock;
+
+static TEXT: LazyLock<BTreeMap<String, String>> = LazyLock::new(|| {
+    serde_json::from_str(include_str!("cli_help.zh-CN.json"))
+        .expect("the bundled Chinese help catalogue must be valid JSON")
+});
+
+fn text(value: &clap::builder::StyledStr) -> String {
+    let value = value.to_string();
+    TEXT.get(&value).cloned().unwrap_or(value)
+}
+
+pub(super) fn localize(mut command: clap::Command) -> clap::Command {
+    if let Some(value) = command.get_about() {
+        let translated = text(value);
+        command = command.about(translated);
+    }
+    if let Some(value) = command.get_long_about() {
+        let translated = text(value);
+        command = command.long_about(translated);
+    }
+    if let Some(value) = command.get_before_help() {
+        let translated = text(value);
+        command = command.before_help(translated);
+    }
+    if let Some(value) = command.get_after_help() {
+        let translated = text(value);
+        command = command.after_help(translated);
+    }
+    command
+        .mut_args(|mut arg| {
+            if let Some(value) = arg.get_help() {
+                let translated = text(value);
+                arg = arg.help(translated);
+            }
+            if let Some(value) = arg.get_long_help() {
+                let translated = text(value);
+                arg = arg.long_help(translated);
+            }
+            arg
+        })
+        .mut_subcommands(localize)
+}
+
+/// Clap's own English headings are translated only in help output, never in user arguments.
+pub(super) fn render_help(error: &clap::Error) -> String {
+    error
+        .to_string()
+        .replace("Usage:", "用法：")
+        .replace("Commands:", "命令：")
+        .replace("Arguments:", "参数：")
+        .replace("Options:", "选项：")
+        .replace("[default:", "[默认：")
+        .replace("[possible values:", "[可选值：")
+        .replace("[aliases:", "[别名：")
+        .replace("Possible values:", "可选值：")
+        .replace(
+            "Print this message or the help of the given subcommand(s)",
+            "显示此信息或指定子命令的帮助",
+        )
+        .replace(
+            "Print help (see more with '--help')",
+            "显示帮助（使用 --help 查看详情）",
+        )
+        .replace(
+            "Print help (see a summary with '-h')",
+            "显示帮助（使用 -h 查看摘要）",
+        )
+        .replace("Print help", "显示帮助")
+        .replace("Print version", "显示版本")
+}
+
+pub(super) fn exit(error: clap::Error) -> ! {
+    use clap::error::ErrorKind;
+    if matches!(
+        error.kind(),
+        ErrorKind::DisplayHelp | ErrorKind::DisplayHelpOnMissingArgumentOrSubcommand
+    ) {
+        use std::io::Write;
+        let output = render_help(&error);
+        if error.use_stderr() {
+            let _ = std::io::stderr().lock().write_all(output.as_bytes());
+        } else {
+            let _ = std::io::stdout().lock().write_all(output.as_bytes());
+        }
+        std::process::exit(error.exit_code());
+    }
+    error.exit()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use clap::CommandFactory;
+
+    fn schema(command: &clap::Command) -> serde_json::Value {
+        serde_json::json!({
+            "name": command.get_name(),
+            "args": command.get_arguments().map(|arg| serde_json::json!({
+                "id": arg.get_id().as_str(), "long": arg.get_long(), "short": arg.get_short(),
+                "aliases": arg.get_aliases(), "value_names": format!("{:?}",arg.get_value_names()),
+                "defaults": format!("{:?}",arg.get_default_values()), "env": format!("{:?}",arg.get_env()),
+                "arity": format!("{:?}",arg.get_num_args()), "action": format!("{:?}",arg.get_action()),
+                "possible_values": arg.get_possible_values().iter().map(|v|v.get_name()).collect::<Vec<_>>(),
+                "required": arg.is_required_set(), "global": arg.is_global_set(), "hidden": arg.is_hide_set()
+            })).collect::<Vec<_>>(),
+            "subcommands": command.get_subcommands().map(schema).collect::<Vec<_>>()
+        })
+    }
+
+    #[test]
+    fn help_localization_preserves_argument_schema() {
+        let mut original = crate::MultitoolCli::command();
+        let mut translated = localize(original.clone());
+        original.build();
+        translated.build();
+        assert_eq!(schema(&original), schema(&translated));
+    }
+
+    #[test]
+    fn short_and_nested_help_keep_commands_and_translate_headings() {
+        for args in [
+            vec!["codex", "-h"],
+            vec!["codex", "plugin", "marketplace", "--help"],
+            vec!["codex", "exec", "--help"],
+        ] {
+            let error = crate::config_override_args::try_parse_from(args).unwrap_err();
+            assert_eq!(error.kind(), clap::error::ErrorKind::DisplayHelp);
+            assert_eq!(error.exit_code(), 0);
+            let help = render_help(&error);
+            assert!(help.contains("用法："));
+            assert!(help.contains("选项："));
+            assert!(!help.contains("Print help"));
+            assert!(!help.contains("Usage:"));
+        }
+    }
+
+    #[test]
+    fn catalogue_preserves_inline_code_and_unknown_text() {
+        for (english, chinese) in TEXT.iter() {
+            let snippets = |value: &str| {
+                value
+                    .split('`')
+                    .enumerate()
+                    .filter(|(index, _)| index % 2 == 1)
+                    .map(|(_, v)| v.to_string())
+                    .collect::<Vec<_>>()
+            };
+            assert_eq!(snippets(english), snippets(chinese), "{english}");
+        }
+        assert_eq!(
+            text(&"Unknown provider content".into()),
+            "Unknown provider content"
+        );
+    }
+}
