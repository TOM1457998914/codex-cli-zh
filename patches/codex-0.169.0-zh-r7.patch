+fn render_mcp_table<const N: usize>(headers: [&str; N], rows: &[[String; N]]) -> String {
+    use unicode_width::UnicodeWidthStr;
+    let widths: [usize; N] = std::array::from_fn(|index| {
+        rows.iter()
+            .map(|row| row[index].width())
+            .chain(std::iter::once(headers[index].width()))
