+#[cfg(test)]
+mod localization_tests {
+    use super::*;
+
+    #[test]
+    fn exit_summaries_keep_ongoing_and_stopped_counts_distinct() {
+        for (persistent, interrupted, prefix) in [
+            (true, false, "目前的 token 用量："),
+            (true, true, "token 用量："),
+            (false, false, "token 用量："),
+        ] {
+            let thread_id = ThreadId::new();
+            let info = AppExitInfo {
+                token_usage: crate::token_usage::TokenUsage {
+                    input_tokens: 1200,
+                    cached_input_tokens: 200,
+                    output_tokens: 50,
+                    reasoning_output_tokens: 10,
+                    total_tokens: 1250,
+                },
+                thread_id: Some(thread_id),
+                resume_hint: Some(ResumableThread {
+                    thread_id,
+                    thread_name: None,
+                }),
+                disconnect_info: persistent.then(|| DisconnectInfo {
+                    command: vec!["codex-zh".to_string()],
+                    stop_hint: "按 x".to_string(),
+                }),
+                update_action: None,
+                exit_reason: if interrupted {
+                    ExitReason::TurnInterrupted
+                } else {
+                    ExitReason::UserRequested
+                },
+            };
+            let lines = info.format_exit_messages(false);
+            assert!(lines.iter().any(|line| line
+                == &format!(
+                    "{prefix} 非缓存合计=1,050 输入=1,000 (+ 200 缓存) 输出=50 (推理 10)"
+                )));
+            assert!(lines.iter().any(|line| line.contains("codex-zh resume")));
+            assert!(!lines.iter().any(|line| line.starts_with("Token usage:")));
+        }
+    }
+}
