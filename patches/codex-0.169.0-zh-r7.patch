@@ -0,0 +1,48 @@
+use super::*;
+
+/// Export the public help text without running any command or contacting a service.
+#[test]
+fn export_localization_help_catalog() {
+    fn collect(command: &clap::Command, prefix: &str, rows: &mut Vec<serde_json::Value>) {
+        let name = format!("{prefix} {}", command.get_name())
+            .trim()
+            .to_string();
+        if command.is_hide_set() {
+            return;
+        }
+        for (kind, text) in [
+            ("about", command.get_about()),
+            ("long_about", command.get_long_about()),
+            ("after_help", command.get_after_help()),
+            ("before_help", command.get_before_help()),
+        ] {
+            if let Some(text) = text {
+                rows.push(
+                    serde_json::json!({"command": name, "kind": kind, "text": text.to_string()}),
+                );
+            }
+        }
+        for arg in command.get_arguments().filter(|arg| !arg.is_hide_set()) {
+            for (kind, text) in [("help", arg.get_help()), ("long_help", arg.get_long_help())] {
+                if let Some(text) = text {
+                    rows.push(serde_json::json!({"command": name, "arg": arg.get_id().as_str(), "kind": kind, "text": text.to_string()}));
+                }
+            }
+            for value in arg.get_possible_values() {
+                if let Some(text) = value.get_help() {
+                    rows.push(serde_json::json!({"command":name,"arg":arg.get_id().as_str(),"value":value.get_name(),"kind":"value_help","text":text.to_string()}));
+                }
+            }
+        }
+        for subcommand in command.get_subcommands() {
+            collect(subcommand, &name, rows);
+        }
+    }
+    let command = MultitoolCli::command();
+    let mut rows = Vec::new();
+    collect(&command, "", &mut rows);
+    assert!(rows.len() > 100);
+    if let Some(destination) = std::env::var_os("CODEX_ZH_HELP_EXPORT") {
+        std::fs::write(destination, serde_json::to_vec_pretty(&rows).unwrap()).unwrap();
+    }
+}
