+fn localization_keeps_user_and_assistant_text_verbatim() {
+    let message = "Cancel\nDefault\nOther\nUser message\nWorking\nON_USE\n中文 e\u{301}🦀";
+    let cell = new_user_prompt(message.into(), Vec::new(), Vec::new(), Vec::new());
