+#[test]
+fn chinese_navigation_keeps_key_styling_without_rewriting_prose() {
+    use ratatui::style::Modifier;
+    let english = super::navigation_line("enter accept · esc cancel");
+    let chinese = super::navigation_line("enter 接受 · esc 取消");
+    let keys = |line: &Line<'_>| {
+        line.spans
+            .iter()
+            .filter(|span| span.style.add_modifier.contains(Modifier::BOLD))
+            .map(|span| span.content.to_string())
+            .collect::<Vec<_>>()
+    };
+    assert_eq!(keys(&english), keys(&chinese));
+    assert!(!keys(&chinese).is_empty());
+    assert_eq!(chinese.to_string(), "enter 接受 · esc 取消");
+    let user_text = "user-provided text with enter";
+    let untouched = super::navigation_line(user_text);
+    assert_eq!(untouched.to_string(), user_text);
+    assert!(keys(&untouched).is_empty());
+}
