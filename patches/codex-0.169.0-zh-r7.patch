index a71bc5265025d3b0551569ebf569a4bdf9f6da2c..c86323eba5387af7d6f04ac5f41d867fc4adcd7a 100644
--- a/codex-rs/tui/src/test_backend.rs
+++ b/codex-rs/tui/src/test_backend.rs
@@ -11,6 +11,93 @@ use ratatui::buffer::Cell;
 use ratatui::layout::Position;
 use ratatui::layout::Size;
 
+/// Read visible text without treating the continuation cells of wide glyphs as spaces.
+pub(crate) fn row_text(row: &[Cell]) -> String {
+    cells_text(row)
+}
+
+pub(crate) fn cells_text<'a>(cells: impl IntoIterator<Item = &'a Cell>) -> String {
+    crate::terminal_hyperlinks::strip_osc8(&cells_text_with_links(cells))
+}
+
+pub(crate) fn cells_text_with_links<'a>(cells: impl IntoIterator<Item = &'a Cell>) -> String {
+    let mut text = String::new();
+    let mut continuation = 0;
+    for cell in cells {
+        if continuation > 0 {
+            continuation -= 1;
+            continue;
+        }
+        let visible = crate::terminal_hyperlinks::strip_osc8(cell.symbol());
+        if visible.is_empty() {
+            text.push(' ');
+        } else {
+            text.push_str(cell.symbol());
+        }
+        continuation = unicode_width::UnicodeWidthStr::width(visible.as_str()).max(1) - 1;
+    }
+    text
+}
+
+pub(crate) fn buffer_row_text(
+    buffer: &ratatui::buffer::Buffer,
+    x: u16,
+    y: u16,
+    width: u16,
+) -> String {
+    cells_text((x..x + width).map(|column| &buffer[(column, y)]))
+}
+
+pub(crate) fn buffer_row_text_with_links(
+    buffer: &ratatui::buffer::Buffer,
+    x: u16,
+    y: u16,
+    width: u16,
+) -> String {
+    cells_text_with_links((x..x + width).map(|column| &buffer[(column, y)]))
+}
+
+/// Take a rendered prefix using terminal columns rather than Unicode scalar count.
+pub(crate) fn prefix_columns(text: &str, columns: usize) -> String {
+    use unicode_segmentation::UnicodeSegmentation;
+    let mut used = 0;
+    text.graphemes(true)
+        .take_while(|glyph| {
+            used += unicode_width::UnicodeWidthStr::width(*glyph);
+            used <= columns
+        })
+        .collect()
+}
+
+/// Extract a link or selection by terminal columns, preserving complete graphemes.
+pub(crate) fn column_range(text: &str, columns: std::ops::Range<usize>) -> String {
+    let end = prefix_columns(text, columns.end);
+    let start = prefix_columns(text, columns.start);
+    end[start.len()..].to_owned()
+}
+
+/// Visible glyph cells, excluding a wide glyph's unused continuation cells.
+pub(crate) fn glyph_cells(row: &[Cell]) -> impl Iterator<Item = &Cell> {
+    let mut continuation = 0;
+    row.iter().filter(move |cell| {
+        if continuation > 0 {
+            continuation -= 1;
+            return false;
+        }
+        let text = crate::terminal_hyperlinks::strip_osc8(cell.symbol());
+        continuation = unicode_width::UnicodeWidthStr::width(text.as_str()).max(1) - 1;
+        true
+    })
+}
+
+#[test]
+fn row_text_preserves_wide_and_combining_glyphs() {
+    let mut buffer = ratatui::buffer::Buffer::empty(ratatui::layout::Rect::new(0, 0, 14, 1));
+    buffer.set_string(0, 0, "A中文e\u{301}🦀", ratatui::style::Style::default());
+    assert_eq!(row_text(&buffer.content).trim_end(), "A中文e\u{301}🦀");
+    assert_eq!(prefix_columns("A中文e\u{301}🦀", 5), "A中文");
+}
